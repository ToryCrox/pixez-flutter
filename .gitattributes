# 自动检测文本文件并统一使用 LF 行尾符
* text=auto eol=lf

# 明确指定 Dart 文件使用 LF
*.dart text eol=lf

# 明确指定其他文本文件使用 LF
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.sh text eol=lf
*.bat text eol=lf
*.ps1 text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

